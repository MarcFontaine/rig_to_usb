MEMORY
{
  FLASH : ORIGIN = 0x08001000, LENGTH = 64K
  RAM   : ORIGIN = 0x20000000, LENGTH = 20K - 8
  TAG_REGION : ORIGIN = 0x20000000 + 20K - 8, LENGTH = 8
}

SECTIONS
{
  .my_pinned_tag (ORIGIN(RAM) + LENGTH(RAM) - 8) (NOLOAD) :
  {
    *(.noinit.BOOTLOADER_TAG);
  } > TAG_REGION
}
INSERT AFTER .text;
